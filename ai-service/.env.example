# Groq API key — get one from https://console.groq.com/keys
# Never commit a real value here.
GROQ_API_KEY=your_groq_api_key_here

# openai/gpt-oss-20b is a currently-available, actively-recommended Groq
# model. Change here if you want a different Groq model — nothing in the
# code hardcodes a model name.
GROQ_MODEL=openai/gpt-oss-20b

PORT=8000

# Phase 10H — shared secret Node sends as the X-Internal-Key header on
# every request to this service. Must match backend/.env's AI_INTERNAL_KEY
# exactly. Never commit a real value here.
AI_INTERNAL_KEY=change-me