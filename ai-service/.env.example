# Groq API key — get one from https://console.groq.com/keys
# Never commit a real value here.
GROQ_API_KEY=your_groq_api_key_here

# openai/gpt-oss-20b is a currently-available, actively-recommended Groq
# model (see https://console.groq.com/docs/model/openai/gpt-oss-20b).
# Change here if you want a different Groq model — nothing in the code
# hardcodes a model name.
GROQ_MODEL=openai/gpt-oss-20b

PORT=8000
