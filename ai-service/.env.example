# Gemini API key — get one from https://aistudio.google.com/apikey
# Never commit a real value here.
GEMINI_API_KEY=

# "gemini-flash-latest" always points at Google's current stable Flash
# model, so it won't silently break when a specific dated model (e.g.
# gemini-2.5-flash) is deprecated. Pin an exact model name instead if you
# need reproducible behavior.
GEMINI_MODEL=gemini-flash-latest

PORT=8000
