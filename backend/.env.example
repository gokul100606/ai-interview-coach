PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas). Never commit a real value.
MONGODB_URI=mongodb://localhost:27017/ai-interview-coach

# Long, random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Origin of the Vite frontend — used for CORS + cookie sameSite behavior
CLIENT_URL=http://localhost:5173

# Internal FastAPI AI service (wired in a later phase)
AI_SERVICE_URL=http://localhost:8000
